corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
corner_detail = 10
anti_aliasing_size = 1.0

[sub_resource type="Shader" id="Shader_rounded"]
code = "shader_type canvas_item;
// Rounded corners for the avatar (the card already clips to its own shape, so the avatar can't clip itself).
uniform vec2 size = vec2(54.0, 54.0);
uniform float radius = 10.0;
varying vec2 local;
void vertex() { local = VERTEX; }
void fragment() {
	vec2 q = abs(local - size * 0.5) - (size * 0.5 - radius);
	float d = length(max(q, 0.0)) - radius;
	COLOR.a *= clamp(0.5 - d, 0.0, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_rounded"]
shader = SubResource("Shader_rounded")
shader_parameter/size = Vector2(54, 54)
shader_parameter/radius = 10.0

