[gd_scene format=3]

[ext_resource type="Theme" path="res://Resources/Multiplayer/LobbyTheme.tres" id="1_theme"]
[ext_resource type="Script" path="res://Script/Multiplayer/Lobby/LobbyPlayerRow.cs" id="2_script"]
[ext_resource type="Texture2D" uid="uid://dgks5gkrmoe4k" path="res://Resources/System/Masks/circle.png" id="3_mask"]
[ext_resource type="Texture2D" uid="uid://c7qlt2q1n5tmy" path="res://Resources/System/guest.png" id="4_guest"]

[node name="LobbyPlayerRow" type="PanelContainer" node_paths=PackedStringArray("NameLabel", "HostBadge", "YouBadge", "DetailLabel", "StatusPill", "MakeHostButton")]
custom_minimum_size = Vector2(0, 58)
size_flags_horizontal = 3
theme = ExtResource("1_theme")
theme_type_variation = &"LobbyRow"
script = ExtResource("2_script")
NameLabel = NodePath("H/Info/Name")
HostBadge = NodePath("H/Info/Tags/HostBadge")
YouBadge = NodePath("H/Info/Tags/YouBadge")
DetailLabel = NodePath("H/Info/Detail")
StatusPill = NodePath("H/Info/Tags/Status")
MakeHostButton = NodePath("H/MakeHost")

[node name="H" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Avatar" type="TextureRect" parent="H"]
clip_children = 1
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("3_mask")
expand_mode = 1

[node name="Icon" type="TextureRect" parent="H/Avatar"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("4_guest")
expand_mode = 1
stretch_mode = 6

[node name="Info" type="VBoxContainer" parent="H"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 4

[node name="Name" type="Label" parent="H/Info"]
layout_mode = 2
text = "Player name"
clip_text = true
text_overrun_behavior = 3

[node name="Tags" type="HBoxContainer" parent="H/Info"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Status" type="Label" parent="H/Info/Tags"]
layout_mode = 2
theme_type_variation = &"LobbyPill"
text = "NOT READY"

[node name="HostBadge" type="Label" parent="H/Info/Tags"]
layout_mode = 2
tooltip_text = "Picks the beatmap and runs the timer"
mouse_filter = 0
theme_type_variation = &"LobbyAccentPill"
text = "HOST"

[node name="YouBadge" type="Label" parent="H/Info/Tags"]
layout_mode = 2
theme_type_variation = &"LobbyPill"
text = "YOU"

[node name="Detail" type="Label" parent="H/Info"]
visible = false
layout_mode = 2
theme_type_variation = &"LobbySubtle"
theme_override_font_sizes/font_size = 12
text = "0   100.00%   0x"

[node name="MakeHost" type="Button" parent="H"]
visible = false
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Hand the host controls to this player"
theme_type_variation = &"LobbyGhostButton"
text = "Make host"

[connection signal="pressed" from="H/MakeHost" to="." method="OnMakeHostPressed"]
